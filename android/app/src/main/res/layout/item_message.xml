<?xml version="1.0" encoding="utf-8"?>
<!-- One message bubble (desktop MessageBubble). Side, colors and which parts show are set in MessageAdapter. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="4dp"
    android:paddingVertical="2dp">

    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/sender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- IMAGE -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="#14000000"
            android:contentDescription="@string/photo"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearance="@style/ShapePhoto" />

        <!-- FILE, AUDIO, VOICE: [round button] [title / progress / info] [save] -->
        <LinearLayout
            android:id="@+id/attachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/attachmentButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="@string/open"
                android:scaleType="center"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/attachmentTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/tg_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/attachmentSeek"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:max="1000"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/attachmentInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tg_secondary_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/saveButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/save"
                android:src="@drawable/ic_download"
                app:tint="@color/tg_secondary_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:textColor="@color/tg_text"
            android:textColorLink="@color/tg_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="1dp"
            android:textColor="@color/tg_secondary_text"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
