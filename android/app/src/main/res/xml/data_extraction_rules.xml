<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing to back up or transfer (chats live in memory; only the last login is stored). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
