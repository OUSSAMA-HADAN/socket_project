<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sockets to the chat server -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17+: needed to reach a private address (10.0.2.2, 192.168.x.x), i.e. the server on
         our PC. Without it the connection is silently dropped and times out. Asked at runtime. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Stay connected in the background (ChatService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Android 13+: message notifications. Asked at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice messages. Asked at runtime the first time the mic button is tapped. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name="mobile.ChatApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChatFX">

        <activity
            android:name="mobile.ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="mobile.ui.ChatsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name="mobile.ui.ChatActivity"
            android:exported="false"
            android:parentActivityName="mobile.ui.ChatsActivity" />

        <activity
            android:name="mobile.ui.ImageViewerActivity"
            android:exported="false" />

        <!-- Lets other apps (PDF reader, gallery...) open a received file we stored in our cache -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="chatfx.mobile.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- "remoteMessaging": a foreground service that keeps a messaging connection open -->
        <service
            android:name="mobile.ChatService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
    </application>
</manifest>
