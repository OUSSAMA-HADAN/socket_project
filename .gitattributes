# Store text files with LF line endings in the repository, whatever the OS.
* text=auto

# Windows scripts need CRLF, Unix scripts need LF.
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf
*.sh text eol=lf

# Binary files: never touch them.
*.png binary
*.jpg binary
*.jar binary
*.wav binary
